  "plugins": [
    {
      "name": "dictation",
      "displayName": "Dictation",
      "description": "Speak into the composer: a microphone button that writes what you say at the cursor, through any OpenAI-compatible transcription service (OpenAI's own, another provider's, or a whisper server on your computer).",
