      "author": {
        "name": "moreweb",
        "url": "https://moreweb.space"
      },
      "homepage": "https://github.com/morewebs/OpenRemote/tree/main/examples/plugins/dictation",
      "license": "AGPL-3.0-only",
      "category": "productivity",
      "keywords": [
        "dictation",
        "voice",
        "speech-to-text",
        "whisper"
      ],
      "source": "./examples/plugins/dictation",
      "metadata": {
        "openremote": {
          "runtime": "js",
          "powers": [
            "microphone",
            "network"
          ]
        }
      }
    }
  ]
