{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRemote",
  "version": "0.3.1",
  "identifier": "space.moreweb.openremote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRemote",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#0a0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26,
      "versionCode": 3
    },
    "targets": [
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/openremote-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
